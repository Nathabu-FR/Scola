{
  "identifier": "default",
  "description": "Permissions for the Scola desktop window",
  "local": true,
  "permissions": [
    "core:default",
    "http:allow-fetch",
    "http:allow-fetch-send",
    "http:allow-fetch-read-body",
    "http:allow-fetch-cancel",
    "http:allow-fetch-cancel-body",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.ecoledirecte.com/**"
        },
        {
          "url": "https://*.ecoledirecte.com/**"
        },
        {
          "url": "https://*.pronote.com/**"
        },
        {
          "url": "https://*.index-education.com/**"
        },
        {
          "url": "https://*.indexeducation.com/**"
        },
        {
          "url": "https://raw.githubusercontent.com/**"
        },
        {
          "url": "https://*.githubusercontent.com/**"
        },
        {
          "url": "https://api.github.com/**"
        },
        {
          "url": "https://data.geopf.fr/**"
        },
        {
          "url": "https://data.education.gouv.fr/**"
        },
        {
          "url": "https://calendar.google.com/**"
        },
        {
          "url": "https://*.index-education.net/**"
        },
        {
          "url": "https://index-education.net/**"
        }
      ]
    }
  ],
  "$schema": "../gen/schemas/desktop-schema.json",
  "windows": [
    "main"
  ]
}
